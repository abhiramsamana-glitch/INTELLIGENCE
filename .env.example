# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Port on which the Express server runs (default: 3000)
PORT=3000

# SUPABASE_URL: Optional Supabase project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL="https://your-project.supabase.co"

# SUPABASE_ANON_KEY: Optional Supabase Anon public key
SUPABASE_ANON_KEY="your-supabase-anon-key"

# SUPABASE_SERVICE_ROLE_KEY: Optional Supabase Service Role key (server only)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
